# W1 (docs/RX_WM8805_SPDIF_PROPOSAL.md §9.8): DAC_TEST na placa do AudioCast (ESP ac:27:6e:a5:4e:10) -> WM8805 -> SU-2.
# Pinos do AudioCast (sdkconfig H1-D1.16B): MCLK 18, BCLK 16, LRCK 8, DOUT 15. LED desligado (estado da ponte RGB por confirmar).
# (a5) V5: 48076,9 Hz, MCLK emitido, seno 1031 Hz a -120 dBFS sobre DC de 128 LSB24 nos dois canais.
# 1031 Hz e nao 997: afasta o tom da harmonica de 1000 Hz da rede (50 Hz), que pode existir no piso da gravacao.
CONFIG_AUDIOLINK_DAC_FREQ_HZ=1031
CONFIG_AUDIOLINK_AUDIO_ROLE_DAC=y
CONFIG_AUDIOLINK_PIN_MCLK=18
CONFIG_AUDIOLINK_PIN_BCLK=16
CONFIG_AUDIOLINK_PIN_WS=8
CONFIG_AUDIOLINK_PIN_DATA=15
CONFIG_AUDIOLINK_PIN_XSMT=-1
CONFIG_ALK_LED_GPIO=-1
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_AUDIOLINK_CLK_INT160_13=y
CONFIG_AUDIOLINK_DAC_MCLK_OUT=y
CONFIG_AUDIOLINK_DAC_SIGNAL_LSB24=y
CONFIG_AUDIOLINK_DAC_LEVEL_DBFS=-120
CONFIG_APP_PROJECT_VER="audiolink-w1a5-wm8805-lsb24"
