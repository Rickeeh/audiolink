# AUDIOLINK CORE v1 RC2 - TX. = A do PHYCAL (2abfa75b5) + STARTUP_SUPERVISOR (com WAIT_PEER), sem TRACE_TX_BOOT; restantes opcoes no default (n).
CONFIG_AUDIOLINK_AUDIO_ROLE_LINK_TX=y
CONFIG_AUDIOLINK_CLK_INT160_13=y
CONFIG_AUDIOLINK_LINK_PEER_MAC="28:84:85:58:C7:E4"
CONFIG_AUDIOLINK_STARTUP_SUPERVISOR=y
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="audiolink-core-v1-rc2"
