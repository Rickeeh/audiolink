# L2-12 (31/10, docs/LATENCY_REVIEW_2026-10-30.md §8): L1 0e60ad7 com a margem RF de 15 para 12 blocos (-8,0 ms). Translacao pura das relacoes do R1/JB40: TARGET = (BUFFER+0,5)*128; HIGH - (TARGET+HYST) = 224; QUEUE_DEPTH*128 - HIGH = 128. Margem minima real (ocupacao inteira em regime oscila entre BUFFER-1 e BUFFER) = 11 blocos = 29,3 ms. DMA, ocultacao, resync, PHY, canal, TX e protocolo iguais ao L1.
CONFIG_AUDIOLINK_AUDIO_ROLE_LINK_RX=y
CONFIG_AUDIOLINK_CLK_INT160_13=y
CONFIG_AUDIOLINK_LINK_PEER_MAC="28:84:85:64:1D:EC"
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="audiolink-l2-12-rx-wm8805"
CONFIG_AUDIOLINK_PIN_MCLK=18
CONFIG_AUDIOLINK_PIN_BCLK=16
CONFIG_AUDIOLINK_PIN_WS=8
CONFIG_AUDIOLINK_PIN_DATA=15
CONFIG_AUDIOLINK_PIN_XSMT=-1
CONFIG_AUDIOLINK_DAC_MCLK_OUT=y
CONFIG_ALK_LED_GPIO=48
CONFIG_AUDIOLINK_LINK_RX_BUFFER_BLOCKS=12
CONFIG_AUDIOLINK_LINK_DRIFT_TARGET_FRAMES=1600
CONFIG_AUDIOLINK_LINK_REBUFFER_HIGH_WATER_FRAMES=1920
CONFIG_AUDIOLINK_LINK_RX_CONCEAL_FADE=y
CONFIG_AUDIOLINK_LINK_RX_RESYNC_KEEP_RUN=y
CONFIG_AUDIOLINK_LINK_RX_I2S_DMA_DESC=4
CONFIG_AUDIOLINK_LINK_RX_I2S_AUTO_CLEAR=y
